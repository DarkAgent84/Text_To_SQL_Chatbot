# .env.example — safe to commit, no real secrets
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=text_to_sql_db

# MySQL Configuration
# MYSQL_USER=root
# MYSQL_PASSWORD=root
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_DB=text_to_sql_db

# Direct Connection URL (Optional)
# DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/text_to_sql_db